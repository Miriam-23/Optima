# ---- Correo -----------------------------------------------------------
# brevo | resend | smtp | console
EMAIL_PROVIDER=console

# Solo si EMAIL_PROVIDER=brevo
BREVO_API_KEY=

# Solo si EMAIL_PROVIDER=resend
RESEND_API_KEY=

# Solo si EMAIL_PROVIDER=smtp (local o Railway Pro)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu_correo
EMAIL_HOST_PASSWORD=tu_password_de_aplicacion

# Debe ser un remitente verificado en el proveedor
DEFAULT_FROM_EMAIL=Optima <no-reply@tudominio.com>

# ---- URLs -------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# ---- Otros ------------------------------------------------------------
GROQ_API_KEY=tu_api_key

DB_NAME=optima_db
DB_USER=postgres
DB_PASSWORD=tu_contrasena
DB_HOST=localhost
DB_PORT=5432

SECRET_KEY=django-secret-key
DEBUG=True
